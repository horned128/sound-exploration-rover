{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Firmware: Build All",
      "dependsOrder": "sequence",
      "dependsOn": [
        "RA8P1: Generate + Clean Build All",
        "ESP32: Build"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "RA8P1: Generate + Clean Build All",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}\\.vscode\\scripts\\Invoke-RaBuild.ps1",
        "-Target",
        "All",
        "-Regenerate",
        "-Clean"
      ],
      "osx": {
        "command": "/bin/bash",
        "args": [
          "${workspaceFolder}/.vscode/scripts/Invoke-RaBuild.sh",
          "--target",
          "All",
          "--regenerate",
          "--clean"
        ]
      },
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
